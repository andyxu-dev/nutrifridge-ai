# NutriFridge AI — Backend Environment Variables
# Copy this file to .env and fill in your values.

# ── AI Nutrition Assistant ─────────────────────────────────────────────────
# Required for the AI Nutrition Assistant (/assistant/chat).
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ── Database ───────────────────────────────────────────────────────────────
# Optional SQLite database location override.
# Default when unset: sqlite:///./nutrifridge.db
# Set this in the process environment BEFORE starting uvicorn.
# Copying this file alone does not load environment variables automatically.
# Current startup migrations are SQLite-oriented; do not treat this as broad
# PostgreSQL/MySQL production support.
# SQLALCHEMY_DATABASE_URL=sqlite:///./nutrifridge.db

# ── Server ─────────────────────────────────────────────────────────────────
# PORT=8000
